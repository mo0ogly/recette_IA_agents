{
  "kind": "maf_orchestration",
  "style": "magentic",
  "agent_id": "magentic-research-correct",
  "name": "Magentic Research Task",
  "description": "A manager plans and selects the next specialist each round until the task is satisfied.",
  "source": { "standard": "microsoft-agent-framework", "orchestration": "MagenticBuilder" },
  "termination": { "max_hops": 8 },
  "participants": [
    {
      "agent_id": "planner",
      "declared_identity": { "provider": "AzureOpenAI", "model": "=Env.MODEL" }
    },
    {
      "agent_id": "researcher",
      "declared_identity": { "provider": "AzureOpenAI", "model": "=Env.MODEL" },
      "tools": [
        { "tool_kind": "web_search", "target": "web_search", "approval": "never" }
      ]
    },
    {
      "agent_id": "writer",
      "declared_identity": { "provider": "AzureOpenAI", "model": "=Env.MODEL" }
    }
  ]
}
