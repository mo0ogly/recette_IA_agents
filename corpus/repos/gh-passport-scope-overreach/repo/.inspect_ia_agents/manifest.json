{
  "schema_version": "1.0",
  "agent": {
    "name": "acme-overreach-pr-bot",
    "description": "Reads acme repositories and pushes branch updates while bumping dependencies.",
    "target_system": "github",
    "identity": {
      "auth_method": "github_app",
      "principal": "acme-overreach-pr-bot[bot]"
    },
    "capabilities": [
      { "action": "read_repo", "mode": "read", "resources": ["acme/*"] },
      { "action": "push", "mode": "write", "resources": ["acme/*"] }
    ]
  }
}
