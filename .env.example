# inspect_ia_agents recette -- environment template.
# Copy to .env and fill in the values you need. .env is gitignored (R8): never
# commit real keys. The API auto-loads .env from the repo root at startup;
# values already present in the environment win over the file.

# --- AI provider keys (only the ones you use are required) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
# openai_compat backends (Ollama, vLLM, LiteLLM proxies...) take base_url per
# ai_backend entry; their key, if any, is the provider's own env var above
# or none for local servers.

# --- Corpus passport test authority (Contrat 3) ---
# Test authority signing seed for corpus passports (PUBLICLY KNOWN test key,
# never a real secret -- R8). 32-byte hex. Reproducible: it is the SHA-256 of the
# phrase "inspect_ia_agents corpus test authority passport seed v1". The matching
# Ed25519 public key is committed at corpus/keys/test-authority.trust.json under
# key_id "test-authority-1". Used only to re-issue corpus/repos/*/repo/.inspect_ia_agents/passport.json.
INSPECT_IA_AGENTS_PASSPORT_KEY=46b780099aa6e71c37b3c87ac32872cd1cfdbcd1276e598aa8e7e083fd24150e

# --- Operational (override only if you need to) ---
# Proxy side-effect tracing for the cockpit network log (R5). on|1|true|yes.
# Off by default: when off, /proxy and the cockpit network panel record nothing.
# INSPECT_IA_AGENTS_PROXY_DEBUG=on
# INSPECT_IA_AGENTS_API_HOST=127.0.0.1
# INSPECT_IA_AGENTS_API_PORT=8090
# INSPECT_IA_AGENTS_CONFIG_PATH=config/inspect_ia_agents.config.json
# INSPECT_IA_AGENTS_EVENT_STORE_PATH=data/inspect_ia_agents.events.db
# INSPECT_IA_AGENTS_VERDICTS_PATH=data/verdicts.json
