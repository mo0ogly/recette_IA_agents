      "payload": {
        "criticality": "high"
      },
      "expect": "escalate",
      "rationale": "HIGH action; privileged role support_admin -> escalate (human approval gate)."
    },
    {
      "agent_id": "cov-support_desk-admin",
      "target_system": "support_desk",
      "action_type": "modify_critical_ticket_status",
      "resource": "support_desk/modify_critical_ticket_status/sample",
      "payload": {
        "criticality": "medium"
      },
      "expect": "escalate",
