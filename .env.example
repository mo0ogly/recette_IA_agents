# AgentRail recette -- environment template.
# Copy to .env and fill in the values you need. .env is gitignored (R8): never
# commit real keys. The API auto-loads .env from the repo root at startup;
# values already present in the environment win over the file.

# --- AI provider keys (only the ones you use are required) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
# openai_compat backends (Ollama, OpenRouter, vLLM...) take base_url per
# ai_backend entry; their key, if any, is the provider's own env var above
# or none for local servers.

# --- Operational (override only if you need to) ---
# AGENTRAIL_API_HOST=127.0.0.1
# AGENTRAIL_API_PORT=8090
# AGENTRAIL_CONFIG_PATH=config/agentrail.config.json
# AGENTRAIL_EVENT_STORE_PATH=data/agentrail.events.db
# AGENTRAIL_VERDICTS_PATH=data/verdicts.json
