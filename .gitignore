# --- Secrets / local config (never commit) ---
.env
.env.*
!.env.example
*.key
*.pem
*.creds
.claude/settings.local.json

# --- Rust ---
/target
**/target
Cargo.lock.orig
*.rs.bk

# --- Node / React frontend ---
node_modules/
dist/
build/
.vite/
.docusaurus/
*.local
npm-debug.log*
yarn-error.log*

# --- inspect_ia_agents local state ---
# Tracking (plans, PDCA, RETEX, decision/action logs) is session-local, not versioned.
docs/tracking/

# --- Claude local artifacts ---
.claude/_archive_lia/
.claude/backups/
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/state/

# --- OS / editor ---
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Python bytecode
__pycache__/
*.pyc

# Python virtualenvs and tool caches (audit toolchain venv is a local artifact)
.venv/
.venv-*/
venv/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# recette.sh runtime state (API pid/logs)
.run/

# Runtime event store (append-only state, regenerated at runtime)
data/*.events.db
data/*.events.db-shm
data/*.events.db-wal

# Runtime campaign + recording artifacts
config/campaigns.json
data/recordings/

# Runtime operational state sidecar (e.g. containment flag) -- never the corpus
config/*.runtime.json

# Runtime verdict submissions + lab access logs (regenerated at runtime)
data/verdicts.json
data/lab/

# Per-backend AI API keys (R8: secrets, never committed)
data/backend_secrets.json

# Assist copilot prompt overrides (operator preference, not corpus ground truth)
data/assist_prompt_overrides.json

# Assist copilot session memory (runtime sidecar, survives API restarts)
data/assist_sessions.runtime.json

# Runtime agent passports (R8: local attestation store, never committed --
# only TEST fixtures under tests/fixtures/agent_passports/ are versioned)
data/agent_passports/

# Coverage measurement artifact (local only)
.coverage

# discoveryprobe Rust crate build artifacts (native, out of base image -- R22)
discoveryprobe/target/
discoveryprobe/discoveryprobe-ebpf/target/

# PDCA audit work-memory at repo root is forbidden (R25) -- belongs under docs/tracking/pdca/
pdca/
