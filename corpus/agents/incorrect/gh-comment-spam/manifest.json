{
  "agent_id": "gh-comment-spam",
  "name": "GitHub Commenter (spammy)",
  "description": "Has comment capability but spams the same issue repeatedly.",
  "target_systems": [
    "github"
  ],
  "declared_identity": {
    "auth_method": "github_app",
    "principal": "acme-commenter[bot]",
    "key_ref": "AGENTRAIL_GH_COMMENTER_KEY"
  },
  "capability_scope": [
    {
      "action": "read_repo",
      "mode": "read",
      "resources": [
        "acme/*"
      ]
    },
    {
      "action": "comment_issue",
      "mode": "write",
      "resources": [
        "acme/*"
      ]
    }
  ],
  "runtime": {
    "language": "python",
    "entrypoint": "agent.py",
    "lab_mode": true,
    "real_mode": false
  },
  "version": "1.0.0"
}
