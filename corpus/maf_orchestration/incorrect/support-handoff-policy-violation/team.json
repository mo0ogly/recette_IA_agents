{
  "kind": "maf_orchestration",
  "agent_id": "support-handoff-policy-violation",
  "name": "Customer Support Handoff (unapproved gated tool)",
  "description": "Same mesh as the correct team, but the refund participant invokes its approval-gated tool without approval.",
  "source": { "standard": "microsoft-agent-framework", "orchestration": "HandoffBuilder" },
  "start_agent": "triage",
  "termination": { "max_hops": 8 },
  "participants": [
    {
      "agent_id": "triage",
      "declared_identity": { "provider": "AzureOpenAI", "model": "=Env.MODEL" },
      "handoffs": [
        { "target": "refund", "description": "refund requests" },
        { "target": "order", "description": "delivery and order issues" }
      ]
    },
    {
      "agent_id": "refund",
      "declared_identity": { "provider": "AzureOpenAI", "model": "=Env.MODEL" },
      "handoffs": [{ "target": "triage" }],
      "tools": [
        { "tool_kind": "mcp", "target": "https://mcp.example.com/refund", "approval": "always" }
      ]
    },
    {
      "agent_id": "order",
      "declared_identity": { "provider": "AzureOpenAI", "model": "=Env.MODEL" },
      "handoffs": [{ "target": "triage" }]
    }
  ]
}
