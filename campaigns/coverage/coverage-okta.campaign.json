      "payload": {
        "criticality": "medium"
      },
      "expect": "escalate",
      "rationale": "MEDIUM action; privileged role identity_admin -> escalate (human approval gate)."
    },
    {
      "agent_id": "cov-okta-admin",
      "target_system": "okta",
      "action_type": "revoke_long_lived_token",
      "resource": "okta/revoke_long_lived_token/sample",
      "payload": {
        "criticality": "high"
      },
      "expect": "escalate",
      "rationale": "HIGH action; privileged role identity_admin -> escalate (human approval gate)."
    },
    {
      "agent_id": "cov-okta-admin",
      "target_system": "okta",
      "action_type": "suspend_user",
      "resource": "okta/suspend_user/sample",
      "payload": {
        "criticality": "high"
      },
      "expect": "escalate",
      "rationale": "HIGH action; privileged role identity_admin -> escalate (human approval gate)."
    }
  ]
}
