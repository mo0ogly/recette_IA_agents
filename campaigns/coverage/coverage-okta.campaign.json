      "resource": "okta/modify_user_roles/sample",
      "payload": {
        "criticality": "high"
      },
      "expect": "escalate",
      "rationale": "HIGH action; privileged role identity_admin -> escalate (human approval gate)."
    },
    {
      "agent_id": "cov-okta-admin",
      "target_system": "okta",
