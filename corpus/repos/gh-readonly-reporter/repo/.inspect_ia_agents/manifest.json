{
  "schema_version": "1.0",
  "agent": {
    "name": "acme-readonly-reporter",
    "description": "Generates a weekly read-only activity report for acme repositories.",
    "target_system": "github",
    "identity": {
      "auth_method": "github_app",
      "principal": "acme-readonly-reporter[bot]"
    },
    "capabilities": [
      { "action": "read_repo", "mode": "read", "resources": ["acme/*"] },
      { "action": "read_ci", "mode": "read", "resources": ["acme/*"] }
    ]
  }
}
