{
  "agent_id": "gh-issue-triager",
  "credential_principal": "acme-issue-triager[bot]",
  "actions": [
    {
      "action": "list_repos",
      "resource": "acme/widgets"
    },
    {
      "action": "read_repo",
      "resource": "acme/widgets"
    },
    {
      "action": "open_issue",
      "resource": "acme/widgets",
      "params": {
        "title": "triage: crash on startup",
        "body": "needs-repro",
        "labels": [
          "needs-triage",
          "crash"
        ]
      }
    },
    {
      "action": "comment_issue",
      "resource": "acme/widgets",
      "params": {
        "issue": 42,
        "body": "triage: needs-repro",
        "labels": [
          "needs-repro"
        ]
      }
    },
    {
      "action": "comment_issue",
      "resource": "acme/gadgets",
      "params": {
        "issue": 7,
        "body": "triage: bug confirmed",
        "labels": [
          "confirmed-bug"
        ]
      }
    }
  ]
}
