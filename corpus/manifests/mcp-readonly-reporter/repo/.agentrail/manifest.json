{
  "schema_version": "1.0",
  "agent": {
    "name": "acme-status-reporter-mcp",
    "description": "MCP server that reports repository and CI status. Read-only.",
    "target_system": "mcp",
    "identity": {
      "auth_method": "mcp_oauth",
      "principal": "acme-status-reporter@mcp"
    },
    "capabilities": [
      { "action": "read_repo", "mode": "read", "resources": ["acme/*"] },
      { "action": "read_ci", "mode": "read", "resources": ["acme/*"] }
    ]
  },
  "mcp": {
    "server": "acme-status-reporter",
    "transport": "stdio",
    "tools": ["read_repo", "read_ci"]
  }
}
