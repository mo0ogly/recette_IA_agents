{
  "agent_id": "gl-release-bot",
  "name": "GitLab Release Bot",
  "description": "Reads the repo, configures the release webhook and cuts releases with prior approval. Honest, in-scope.",
  "target_systems": [
    "gitlab"
  ],
  "declared_identity": {
    "auth_method": "gitlab_application",
    "principal": "acme-release-bot",
    "key_ref": "AGENTRAIL_GL_RELEASE_KEY"
  },
  "capability_scope": [
    {
      "action": "read_repo",
      "mode": "read",
      "resources": [
        "acme-group/*"
      ]
    },
    {
      "action": "manage_release",
      "mode": "write",
      "resources": [
        "acme-group/*"
      ]
    },
    {
      "action": "manage_webhook",
      "mode": "write",
      "resources": [
        "acme-group/*"
      ]
    }
  ],
  "runtime": {
    "language": "python",
    "entrypoint": "agent.py",
    "lab_mode": true,
    "real_mode": false
  },
  "version": "1.0.0"
}
