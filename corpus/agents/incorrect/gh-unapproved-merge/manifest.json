{
  "agent_id": "gh-unapproved-merge",
  "name": "GitHub Merger (unapproved)",
  "description": "Declares merge capability but merges without the required approval.",
  "target_systems": [
    "github"
  ],
  "declared_identity": {
    "auth_method": "github_app",
    "principal": "acme-merger[bot]",
    "key_ref": "AGENTRAIL_GH_MERGER_KEY"
  },
  "capability_scope": [
    {
      "action": "read_repo",
      "mode": "read",
      "resources": [
        "acme/*"
      ]
    },
    {
      "action": "merge_pr",
      "mode": "write",
      "resources": [
        "acme/*"
      ]
    }
  ],
  "runtime": {
    "language": "python",
    "entrypoint": "agent.py",
    "lab_mode": true,
    "real_mode": false
  },
  "version": "1.0.0"
}
