      "payload": {
        "criticality": "critical"
      },
      "expect": "deny",
      "rationale": "CRITICAL action; privileged role data_admin -> deny (deny-by-default)."
    },
    {
      "agent_id": "cov-data_platform-admin",
      "target_system": "data_platform",
