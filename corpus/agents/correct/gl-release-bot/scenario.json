{
  "agent_id": "gl-release-bot",
  "credential_principal": "acme-release-bot",
  "actions": [
    {
      "action": "read_repo",
      "resource": "acme-group/service-a"
    },
    {
      "action": "manage_webhook",
      "resource": "acme-group/service-a",
      "params": {
        "event": "release",
        "url": "https://ci.acme-group.example/release-hook",
        "secret_token_ref": "INSPECT_IA_AGENTS_GL_RELEASE_HOOK",
        "ssl_verification": true
      },
      "approved": true
    },
    {
      "action": "manage_release",
      "resource": "acme-group/service-a",
      "params": {
        "tag": "v1.2.0",
        "name": "service-a v1.2.0",
        "notes": "Routine release: dependency bumps and CI hardening."
      },
      "approved": true
    }
  ]
}
