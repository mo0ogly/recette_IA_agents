{
  "agent_id": "gh-issue-triager",
  "name": "GitHub Issue Triager",
  "description": "Reads repositories and comments triage labels/notes on issues. Read + comment only.",
  "target_systems": ["github"],
  "declared_identity": {
    "auth_method": "github_app",
    "principal": "acme-issue-triager[bot]",
    "key_ref": "AGENTRAIL_GH_TRIAGER_KEY"
  },
  "capability_scope": [
    { "action": "read_repo", "mode": "read", "resources": ["acme/*"] },
    { "action": "list_repos", "mode": "read", "resources": ["acme/*"] },
    { "action": "comment_issue", "mode": "write", "resources": ["acme/*"] }
  ],
  "runtime": {
    "language": "tbd",
    "entrypoint": "agent.tbd",
    "lab_mode": true,
    "real_mode": false
  },
  "version": "1.0.0"
}
