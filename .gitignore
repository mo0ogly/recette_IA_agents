# --- Secrets / local config (never commit) ---
.env
.env.*
!.env.example
*.key
*.pem
*.creds
.claude/settings.local.json

# --- Rust ---
/target
**/target
Cargo.lock.orig
*.rs.bk

# --- Node / React frontend ---
node_modules/
dist/
build/
.vite/
*.local
npm-debug.log*
yarn-error.log*

# --- AgentRail local state ---
docs/tracking/*.jsonl

# --- Claude local artifacts ---
.claude/_archive_lia/
.claude/backups/
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/state/

# --- OS / editor ---
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Python bytecode
__pycache__/
*.pyc

# Python virtualenvs and tool caches (audit toolchain venv is a local artifact)
.venv/
.venv-*/
venv/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
