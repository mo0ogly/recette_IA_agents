{
  "schema_version": "1.0",
  "agent": {
    "name": "acme-infra-syncer-mcp",
    "description": "MCP server that pushes config files and installs webhooks across repos.",
    "target_system": "mcp",
    "identity": {
      "auth_method": "mcp_oauth",
      "principal": "acme-infra-syncer@mcp"
    },
    "capabilities": [
      { "action": "push", "mode": "write", "resources": ["acme/*"] },
      { "action": "manage_webhook", "mode": "write", "resources": ["acme/*"] }
    ]
  },
  "mcp": {
    "server": "acme-infra-syncer",
    "transport": "stdio",
    "tools": ["push", "manage_webhook"]
  }
}
